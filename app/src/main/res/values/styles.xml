<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.AdAway" parent="Base.AdAway" />

    <!--
        Shared preferences styling: (1) makes every SwitchPreferenceCompat use the
        standard Material 3 MaterialSwitch, (2) keeps the app bar red in dark mode
        (Material would otherwise colour it with colorSurface) and (3) modernises the
        preference dialogs (ListPreference etc.) with rounded corners and Material
        styling. Everything else, the app bar and the system bars included, comes from
        Base.AdAway like every other screen.
    -->
    <style name="Base.AdAway.Prefs" parent="Base.AdAway">
        <item name="switchPreferenceCompatStyle">@style/Preference.AdAway.SwitchPreferenceCompat</item>
        <item name="actionBarStyle">@style/Widget.AdAway.ActionBar</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.AdAway.Dialog</item>
    </style>

    <!--
        Preferences theme. The navigation bar is no longer declared here: it now comes from
        Base.AdAway, which every screen in this family shares, so settings and the rest of
        the app cannot drift apart again.
    -->
    <style name="Theme.AdAway.Prefs" parent="Base.AdAway.Prefs" />

    <!--
        App bar shared by every ActionBar screen (home sub-screens, DNS log, help, lists,
        sources, preferences…). This style only sets the red background; the WHITE title,
        subtitle and icons come from actionBarTheme=ThemeOverlay.AdAway.ActionBar on the base
        theme. The window ActionBar takes its title colour from android:textColorPrimary, NOT
        from titleTextColor (that is a Toolbar attribute), so the Dark.ActionBar overlay is what
        actually flips the text to white on the red bar in both light and dark mode.
    -->
    <style name="Widget.AdAway.ActionBar" parent="Widget.AppCompat.ActionBar.Solid">
        <item name="background">@color/primary</item>
        <item name="android:background">@color/primary</item>
    </style>

    <!-- Forces the app bar title, subtitle and icons white on the red background (both modes). -->
    <style name="ThemeOverlay.AdAway.ActionBar" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar" />

    <!--
        Modern rounded dialog used by the preference screens (e.g. the dark-theme
        picker). Rounded surface, red accent for the selected radio and the buttons.
    -->
    <style name="ThemeOverlay.AdAway.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorControlActivated">@color/primary</item>
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.AdAway.Dialog.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.AdAway.Dialog.Button</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.AdAway.Dialog.Button</item>
    </style>

    <style name="Widget.AdAway.Dialog.Button" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/primary</item>
    </style>

    <!--
        Preference switches use the standard Material 3 MaterialSwitch (same widget as
        e.g. Material Files), via a custom widget layout. No custom tint/drawable: the
        MD3 look comes entirely from the M3 colour tokens + colorPrimary.
    -->
    <style name="Preference.AdAway.SwitchPreferenceCompat" parent="Preference.SwitchPreferenceCompat.Material">
        <item name="android:widgetLayout">@layout/switch_preference_widget_material3</item>
    </style>

    <!--
        The app theme is Material 2, but MaterialSwitch needs the Material 3 colour
        tokens (and materialSwitchStyle) to render its MD3 appearance. We host the
        switch in an isolated M3 theme so it picks those up, while forcing colorPrimary
        to the AdAway red (no dynamic colour, so the checked track is always red).
    -->
    <style name="ThemeOverlay.AdAway.MaterialSwitch" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/onPrimary</item>
    </style>

    <style name="Base.AdAway" parent="Theme.MaterialComponents.DayNight">
        <item name="actionBarStyle">@style/Widget.AdAway.ActionBar</item>
        <item name="actionBarTheme">@style/ThemeOverlay.AdAway.ActionBar</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primaryVariant</item>
        <item name="colorOnPrimary">@color/onPrimary</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="colorSecondaryVariant">@color/primaryVariant</item>
        <item name="colorOnSecondary">@color/onPrimary</item>

        <!--Remap legacy AppCompat attributes to MaterialComponent attributes-->
        <item name="colorPrimaryDark">?colorPrimary</item>
    </style>

    <style name="Theme.AdAway.NoActionBar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primaryVariant</item>
        <item name="colorOnPrimary">@color/onPrimary</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="colorSecondaryVariant">@color/primaryVariant</item>
        <item name="colorOnSecondary">@color/onPrimary</item>
    </style>

    <style name="Theme.AdAway.NoActionBar.Red" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/welcomeBackground</item>
        <item name="colorPrimaryVariant">@color/primaryVariant</item>
        <item name="colorOnPrimary">@color/onPrimary</item>
        <item name="colorSecondary">@color/onPrimary</item>
        <item name="colorSecondaryVariant">@color/primaryVariant</item>
        <item name="colorOnSecondary">@color/welcomeBackground</item>
        <item name="android:windowBackground">@color/welcomeBackground</item>
    </style>

    <!--
        Shared style for every card in the home screen lower zone (sources card and
        the 3 navigation rows). Single source of truth so all cards get an identical,
        soft and discrete elevation shadow. Keep elevation subtle (2dp); do NOT raise
        it to 8/10dp on these large cards.
    -->
    <style name="Widget.AdAway.HomeCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardUseCompatPadding">false</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!--
        TV equivalent of Widget.AdAway.HomeCard: elevation-based shadows render as a
        muddy, uneven smear on Android TV's software-scaled/mirrored output (SHIELD
        desktop client, screen mirroring), where mobile's compositor renders them
        cleanly. A flat card with a thin outline reads just as clearly at 10-foot
        distance and renders identically everywhere, so TV cards use this instead.
        strokeColor uses the same day/night stroke pair as the bump bar
        (bumpBarStroke) rather than ?attr/colorOutline: that theme attribute does
        not resolve to a terminal color in this app's theme and crashes
        MaterialCardView inflation (UnsupportedOperationException, verified on
        device), so a plain color resource is used instead.
    -->
    <style name="Widget.AdAway.TvHomeCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/bumpBarStroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardUseCompatPadding">false</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!--
        Filled white pill button used on the plain red welcome background (battery onboarding
        steps, the TV welcome wizard): the default filled MaterialButton background tints to
        colorPrimary, which is the same red as the page, making it nearly invisible. Disabled
        state (e.g. "Granted ✓") dims both colors instead of just going flat grey, so it still
        reads as intentional/done.

        rippleColor is state_pressed only (welcome_button_ripple), for mobile tap feedback - a
        flat @color/welcomeBackground here used to also cover state_focused, which read as a
        muddy wash for as long as a TV D-pad kept a button focused, since that state sits on
        screen for as long as focus is held rather than being a brief animated burst like a
        tap's ripple. elevation and android:defaultFocusHighlightEnabled are both explicitly
        off for the same reason (an animated shadow, then a system overlay, each also having
        to render for that whole sustained duration) - both were seen cutting off at the
        pill's rounded ends instead of following them, and so was a state list animator that
        scaled the button on focus instead. TV focus is a strokeColor/strokeWidth ring now
        (welcome_button_stroke): drawn along the exact same shape path as the fill itself
        rather than as any kind of separate overlay, transform, or system-drawn layer, so
        there is nothing left that could mismatch it - confirmed working on device, unlike
        every one of the above.
    -->
    <style name="Widget.AdAway.Button.OnRed" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/welcome_button_background</item>
        <item name="android:textColor">@color/welcome_button_text</item>
        <item name="android:textStyle">bold</item>
        <item name="rippleColor">@color/welcome_button_ripple</item>
        <item name="elevation">0dp</item>
        <item name="strokeColor">@color/welcome_button_stroke</item>
        <item name="strokeWidth">3dp</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
    </style>

    <!--
        Welcome (first-run onboarding) screens: fixed, moderate sizes instead of the huge
        Display1/Large presets those screens used before, so a normal phone shows the whole step
        without scrolling. hyphenationFrequency+breakStrategy are the actual backstop against a
        single long word overflowing its column at a large accessibility font scale, far more
        predictable than trying to autosize a multi-line ConstraintLayout-chained TextView, which
        does not reliably report the right wrap_content height in that combination.
    -->
    <style name="TextAppearance.AdAway.Welcome.Header" parent="TextAppearance.AppCompat.Title">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:breakStrategy">high_quality</item>
        <item name="android:hyphenationFrequency">full</item>
    </style>

    <style name="TextAppearance.AdAway.Welcome.Body" parent="TextAppearance.AppCompat.Medium">
        <item name="android:breakStrategy">high_quality</item>
        <item name="android:hyphenationFrequency">full</item>
    </style>

    <style name="TextAppearance.AdAway.Welcome.Small" parent="TextAppearance.AppCompat.Small">
        <item name="android:breakStrategy">high_quality</item>
        <item name="android:hyphenationFrequency">full</item>
    </style>

    <!--
        Rounded-corner shape for the header AdAway logo. Applied to a ShapeableImageView so
        the logo is clipped identically on every device/manufacturer (Android 10 included),
        instead of relying on the per-OEM adaptive-icon mask.
    -->
    <style name="ShapeAppearanceOverlay.AdAway.Logo" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">25%</item>
    </style>
</resources>
